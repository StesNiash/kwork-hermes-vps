# --- Hermes model/provider ---
# Один из вариантов; подробнее: https://hermes-agent.nousresearch.com/docs/integrations/providers
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Telegram gateway ---
# Получить у @BotFather: /newbot
TELEGRAM_BOT_TOKEN=

# --- Dashboard ---
# Dashboard слушает только localhost; для внешнего доступа используйте SSH-туннель
# или профиль proxy (Caddy + HTTPS).
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# --- OpenAI-compatible API server ---
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY=

# --- Optional HTTPS proxy ---
# docker compose --profile proxy up -d
DOMAIN=
LETSENCRYPT_EMAIL=

# --- Image pin ---
# Для воспроизводимого деплоя укажите версию или digest.
HERMES_IMAGE_TAG=latest
